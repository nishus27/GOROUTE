# ============================================================
# GoRoute backend - environment template
# Copy this file to backend/.env and fill in local values.
# NEVER commit backend/.env. NEVER hardcode real keys.
# ============================================================

# Session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret

FLASK_DEBUG=1
PORT=5000

# SQLite is the only supported database.
# Optional override; defaults to backend/instance/goroute.db
# DATABASE_URL=sqlite:///instance/goroute.db

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- External APIs (later phases - leave blank for now) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_MAPS_API_KEY=
