# ============================================================
# GoRoute - Environment Variable Template
# ------------------------------------------------------------
# Copy this file to ".env" and fill in real values locally.
# NEVER commit the real ".env" file. NEVER hardcode keys in code.
# See docs/ENVIRONMENT.md for full details.
# ============================================================

# ---------- Backend (Flask) ----------
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-random-secret
PORT=5000

# SQLite database (relative to backend/)
DATABASE_URL=sqlite:///goroute.db

# ---------- External APIs (backend-only secrets) ----------
# OpenAI is used ONLY for explanations and personalization.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Maps is used for mapping/routing data.
GOOGLE_MAPS_API_KEY=

# ---------- Frontend (Vite) ----------
# Only PUBLIC keys may be exposed to the browser. Must start with VITE_.
VITE_API_BASE_URL=http://localhost:5000
VITE_GOOGLE_MAPS_API_KEY=
